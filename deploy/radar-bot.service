[Unit]
Description=Mini Radar Telegram leads bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=radarbot
Group=radarbot
WorkingDirectory=/opt/radar_bot
EnvironmentFile=/opt/radar_bot/.env
ExecStart=/opt/radar_bot/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/radar_bot/data

[Install]
WantedBy=multi-user.target
